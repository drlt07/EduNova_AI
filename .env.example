# Sao chép file này thành .env rồi điền giá trị. Không đưa .env lên Git.
# Đây là khóa CHUNG của máy chủ (dùng khi giáo viên không điền khóa riêng trong mục "Khóa AI của tôi").
# Nhà cung cấp: mock (giả lập, không cần khóa), anthropic (Claude, trả phí) hoặc gemini (Google, có gói miễn phí).
LLM_PROVIDER=mock
# Khóa API của nhà cung cấp (bắt buộc khi LLM_PROVIDER=anthropic hoặc gemini).
LLM_API_KEY=
# Mô hình (để trống dùng mặc định: claude-opus-5-5 cho anthropic, gemini-flash-latest cho gemini).
LLM_MODEL=

# ---------- Đăng nhập thật (Supabase) ----------
# Để trống cả hai thì app chạy bản dùng thử (chọn tài khoản mẫu, không mật khẩu, dữ liệu trên trình duyệt).
# Lấy ở Supabase Dashboard → Project Settings → API. Anon key là khóa công khai, an toàn khi lộ ra trình duyệt
# vì mọi bảng đều bật RLS. TUYỆT ĐỐI không đặt service_role key vào biến NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (hoặc tên cũ) NEXT_PUBLIC_SUPABASE_ANON_KEY=
